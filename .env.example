# Copy to .env and adjust. Never commit the real .env.
PORT=3001
NODE_ENV=development

# PostgreSQL. On Render/Railway use the connection string they give you.
DATABASE_URL=postgres://agritrack:agritrack@localhost:5432/agritrack
DB_SSL=false
# Creates/updates tables automatically. Set to false once you manage the schema yourself.
DB_SYNC=true

# Required in production: a long random string (for example: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# Loads the demo accounts, crops and harvests when the users table is empty.
SEED_DEMO_DATA=true
# Day boundaries for "not in the future" date checks.
APP_TZ=Asia/Manila
# Login attempts allowed per minute per IP.
LOGIN_RATE_LIMIT=10
